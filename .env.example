# === Cloud-only, free-tier deployment profile ===
# Frontend: Vercel (Next.js) / Backend: Render (FastAPI) / DB: Supabase (Postgres + pgvector)
# Generative AI / embeddings / rerank: Cohere API (free trial key)

# --- database: Supabase connection string (Project Settings > Database > Connection string) ---
# Use the "Session pooler" or direct connection string, psycopg driver:
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

# --- Cohere API (https://dashboard.cohere.com/api-keys) ---
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-r-08-2024
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
COHERE_TIMEOUT_SECONDS=20

# --- api ---
EMBEDDING_DIMENSIONS=1024
# Paths default to web/public/handbook/ and api/data/search_lexicon.yaml; override only if
# you move them (see api/app/config.py for why they live there).
HANDBOOK_DIR=
LEXICON_PATH=
# Comma-separated list of origins allowed to call the API (add your Vercel URL after deploying).
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- admin dashboard ---
# Change both before sharing the app. Leaving ADMIN_PASSWORD empty disables the admin API.
ADMIN_PASSWORD=change-this-for-class
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
